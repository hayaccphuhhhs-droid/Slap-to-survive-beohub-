local function cleanName(name)
    return name:gsub("%s*%b()", ""):gsub("%s+", " ")
end

RunService.RenderStepped:Connect(function()
    -- ESP Zombie
    if not espZombieEnabled then
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:FindFirstChild("ZombieHighlight") then obj.ZombieHighlight:Destroy() end
            if obj:FindFirstChild("ZombieBillboard") then obj.ZombieBillboard:Destroy() end
        end
    else
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("Model") and zombieList[obj.Name] then
                local head = obj:FindFirstChild("Head") or obj:FindFirstChild("HumanoidRootPart")
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if head and hum and hum.Health > 0 then
                    if not obj:FindFirstChild("ZombieHighlight") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "ZombieHighlight"
                        hl.Adornee = obj
                        hl.FillColor = Color3.fromRGB(255, 30, 30)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.FillTransparency = 0.4
                        hl.Parent = obj
                    end
                    if not head:FindFirstChild("ZombieBillboard") then
                        local bb = Instance.new("BillboardGui")
                        bb.Name = "ZombieBillboard"
                        bb.Adornee = head
                        bb.Size = UDim2.new(0, 120, 0, 30)
                        bb.StudsOffset = Vector3.new(0, 3, 0)
                        bb.AlwaysOnTop = true
                        local txt = Instance.new("TextLabel")
                        txt.Size = UDim2.new(1, 0, 1, 0)
                        txt.BackgroundTransparency = 1
                        txt.Text = cleanName(obj.Name)
                        txt.TextColor3 = Color3.fromRGB(255, 80, 80)
                        txt.TextStrokeTransparency = 0
                        txt.Font = Enum.Font.SourceSansBold
                        txt.TextSize = 14
                        txt.Parent = bb
                        bb.Parent = head
                    end
                end
            end
        end
    end

    -- ESP Player
    if not espPlayerEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                if p.Character:FindFirstChild("PlayerHighlight") then p.Character.PlayerHighlight:Destroy() end
                local head = p.Character:FindFirstChild("Head")
                if head and head:FindFirstChild("PlayerBillboard") then head.PlayerBillboard:Destroy() end
            end
        end
    else
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local char = p.Character
                local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if head and hum and hum.Health > 0 then
                    if not char:FindFirstChild("PlayerHighlight") then
                        local hl = Instance.new("Highlight")
                        hl.Name = "PlayerHighlight"
                        hl.Adornee = char
                        hl.FillColor = Color3.fromRGB(0, 255, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        hl.FillTransparency = 0.4
                        hl.Parent = char
                    end
                    if not head:FindFirstChild("PlayerBillboard") then
                        local bb = Instance.new("BillboardGui")
                        bb.Name = "PlayerBillboard"
                        bb.Adornee = head
                        bb.Size = UDim2.new(0, 120, 0, 30)
                        bb.StudsOffset = Vector3.new(0, 3, 0)
                        bb.AlwaysOnTop = true
                        local txt = Instance.new("TextLabel")
                        txt.Size = UDim2.new(1, 0, 1, 0)
                        txt.BackgroundTransparency = 1
                        txt.Text = cleanName(p.Name)
                        txt.TextColor3 = Color3.fromRGB(0, 255, 0)
                        txt.TextStrokeTransparency = 0
                        txt.Font = Enum.Font.SourceSansBold
                        txt.TextSize = 14
                        txt.Parent = bb
                        bb.Parent = head
                    end
                end
            end
        end
    end
end)

