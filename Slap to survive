-- HITBOX
---------------------------------------------------------
task.spawn(function()
    while true do
        if hitboxEnabled then
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and zombieList[obj.Name] then
                    if not Players:GetPlayerFromCharacter(obj) and obj ~= player.Character then
                        local zRoot = obj:FindFirstChild("HumanoidRootPart")
                        local zHum = obj:FindFirstChildOfClass("Humanoid")
                        if zRoot and zHum and zHum.Health > 0 then
                            pcall(function()
                                zRoot.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                                zRoot.Transparency = 0.6
                                zRoot.BrickColor = BrickColor.new("Really red")
                                zRoot.Material = Enum.Material.Neon
                                zRoot.CanCollide = false
                                local shape = zRoot:FindFirstChildOfClass("SpecialMesh")
                                if not shape then
                                    shape = Instance.new("SpecialMesh")
                                    shape.MeshType = Enum.MeshType.Sphere
                                    shape.Parent = zRoot
                                end
                            end)
                        end
                    end
                end
            end
        else
            for _, obj in pairs(workspace:GetDescendants()) do
                if obj:IsA("Model") and zombieList[obj.Name] then
                    local zRoot = obj:FindFirstChild("HumanoidRootPart")
                    if zRoot then
                        pcall(function()
                            zRoot.Size = Vector3.new(2, 2, 1)
                            zRoot.Transparency = 1
                            local shape = zRoot:FindFirstChildOfClass("SpecialMesh")
                            if shape then shape:Destroy() end
                        end)
                    end
                end
            end
        end
        task.wait(0.5)
    end
end)

