-- AUTO FARM + AUTO CLICK
---------------------------------------------------------
local trackedZombies = {}

RunService.Stepped:Connect(function()
    -- Đếm zombie
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and zombieList[obj.Name] then
            local zHum = obj:FindFirstChildOfClass("Humanoid")
            if zHum then
                if not trackedZombies[obj] then
                    trackedZombies[obj] = zHum.Health
                else
                    if trackedZombies[obj] > 0 and zHum.Health <= 0 then
                        zombieKillCount = zombieKillCount + 1
                        killCounterLabel:Set({
                            Title = "Zombie đã hạ",
                            Content = zombieKillCount .. " con"
                        })
                    end
                    trackedZombies[obj] = zHum.Health
                end
            end
        end
    end

    if not autoFarmEnabled then return end
    if not (player.Character and player.Character:FindFirstChild("HumanoidRootPart")) then return end

    local myRoot = player.Character.HumanoidRootPart
    local myHum = player.Character:FindFirstChildOfClass("Humanoid")
    local tool = player.Character:FindFirstChildOfClass("Tool")

    if not myHum or myHum.Health <= 0 then return end

    if myHum.Health < 20 then
        isHealingMode = true
    elseif myHum.Health >= 50 then
        isHealingMode = false
    end

    local zombieListNearby = {}
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and zombieList[obj.Name] then
            if not Players:GetPlayerFromCharacter(obj) and obj ~= player.Character then
                local zRoot = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head")
                local zHum = obj:FindFirstChildOfClass("Humanoid")
                if zRoot and zHum and zHum.Health > 0 then
                    local dist = (myRoot.Position - zRoot.Position).Magnitude
                    table.insert(zombieListNearby, {Model = obj, Root = zRoot, Hum = zHum, Dist = dist})
                end
            end
        end
    end

    table.sort(zombieListNearby, function(a, b) return a.Dist < b.Dist end)

    if isHealingMode or #zombieListNearby == 0 then
        pcall(function()
            local targetY = (lastGroundY or myRoot.Position.Y) + safeHoverHeight
            myRoot.CFrame = CFrame.new(myRoot.Position.X, targetY, myRoot.Position.Z)
            myRoot.AssemblyLinearVelocity = Vector3.zero
        end)
    else
        local targetZombies = {}
        for i = 1, math.min(5, #zombieListNearby) do
            table.insert(targetZombies, zombieListNearby[i])
        end

        local mainTarget = targetZombies[1]
        lastGroundY = mainTarget.Root.Position.Y

        local clumpCFrame = mainTarget.Root.CFrame
        for _, zData in ipairs(targetZombies) do
            pcall(function()
                zData.Root.CFrame = clumpCFrame
                zData.Root.AssemblyLinearVelocity = Vector3.zero
            end)
        end

        pcall(function()
            local targetCFrame = clumpCFrame * CFrame.new(0, heightOffset, backDistance)
            myRoot.CFrame = CFrame.new(targetCFrame.Position, clumpCFrame.Position)
            myRoot.AssemblyLinearVelocity = Vector3.zero

            local currentDist = (myRoot.Position - clumpCFrame.Position).Magnitude
            if currentDist <= attackRange then
                if autoClickEnabled or autoFarmEnabled then
                    if tool then
                        tool:Activate()
                        for _, zData in ipairs(targetZombies) do
                            for _, v in pairs(tool:GetDescendants()) do
                                if v:IsA("RemoteEvent") then
                                    v:FireServer(zData.Root, zData.Hum)
                                end
                            end
                        end
                    end
                    VirtualUser:CaptureController()
                    VirtualUser:ClickButton1(Vector2.new(0, 0))
                end
            end
        end)
    end
end)

